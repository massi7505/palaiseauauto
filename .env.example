// PalpiAuto Commande — variables d'environnement
// PROD (Vercel) : renseignez ces variables dans Vercel > Settings > Environment Variables.
// DEV local : copiez ce fichier en `.env` puis ajustez les valeurs.

// --- Base de données ---
// PROD : Postgres (Neon / Supabase / Prisma Postgres). Exemple :
// DATABASE_URL="postgresql://user:password@host:5432/palpiauto?sslmode=require"
// DEV local : DATABASE_URL="file:./dev.db" + provider "sqlite" dans prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@host:5432/palpiauto?sslmode=require"

// --- Auth.js (NextAuth v5) ---
// Générez un secret avec : npx auth secret
// PROD (Vercel) : AUTH_URL = l'URL publique Vercel (https://votre-app.vercel.app)
AUTH_SECRET="changez-moi-avec-npx-auth-secret-min-32-caracteres"
AUTH_URL="https://votre-app.vercel.app"

// --- WhatsApp ---
// Numéro du garage au format international sans "+" ni espaces.
WHATSAPP_PHONE_NUMBER="33601639959"

// --- WhatsApp Cloud API (Meta) — réception + réponse auto IA ---
// PROD (Vercel) : renseignez ces 3 variables dans Vercel > Settings > Environment Variables.
// NE JAMAIS commiter le vrai token : gardez-le uniquement dans `.env` / Vercel.
// Token d'accès (compte test Meta) — expire ~24h, à régénérer dans
// https://developers.facebook.com/apps > WhatsApp > API Setup.
// L'ID du numéro de téléphone test et l'ID du compte se règlent dans
// /admin/settings > section "WhatsApp & réponse auto (IA)".
WHATSAPP_API_TOKEN=""
WHATSAPP_VERIFY_TOKEN="changez-moi-token-verif-webhook"
// Optionnel mais recommandé en PROD : clé secrète de l'app Meta
// (Dashboard > Paramètres > De base > Clé secrète). Sert à vérifier la
// signature `x-hub-signature-256` de chaque POST webhook. Sans elle,
// la signature n'est pas vérifiée (mode test uniquement).
WHATSAPP_APP_SECRET=""
// Optionnel : URL publique de l'app (ngrok / domaine) pour recevoir le webhook.
// WHATSAPP_WEBHOOK_CALLBACK_URL="https://votre-domaine.fr/api/webhooks/whatsapp"

// --- Seed admin initial (utilisé par `npm run db:seed` en DEV et `vercel.json` en PROD) ---
ADMIN_EMAIL="admin@palpiauto.fr"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrateur"

